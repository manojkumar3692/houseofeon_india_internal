# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxx
NEXT_PUBLIC_BRAND_NAME=House of Eon
NEXT_PUBLIC_SUPPORT_WHATSAPP=919999999999
# Optional: token amount (INR) for the "pay token now, rest COD" checkout
# option. Defaults to 99 if unset.
NEXT_PUBLIC_COD_TOKEN_AMOUNT_INR=99

# Supabase server side only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Keep false during the database/admin rollout. Set true only after verifying
# the 8ml and 50ml counts in the operations Inventory page.
INVENTORY_ENFORCEMENT_ENABLED=false

# Razorpay server side only
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay webhook secret — set this to the same value you enter as the
# "Secret" when creating the webhook in Razorpay Dashboard -> Settings ->
# Webhooks, pointed at https://www.houseofeon.in/api/webhooks/razorpay,
# subscribed to at least payment.captured and payment.failed. This is what
# lets /api/webhooks/razorpay verify a call genuinely came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=e15c114dc34f39f063c108e10d66a49b4765bdfd4fff9e9e24d024a7a9c54b40

# Delhivery — server side only. Create the pickup location in Delhivery One
# with this exact name before enabling the integration. Shipment creation is
# triggered only after Razorpay sends a signed payment.captured webhook.
DELHIVERY_API_TOKEN=your-live-delhivery-api-token
DELHIVERY_PICKUP_LOCATION="HOUSE OF EON HUB"
# Defaults to the address above when omitted. Set these if Delhivery requires
# explicit seller/return details for your account.
DELHIVERY_SELLER_NAME="House of Eon"
DELHIVERY_RETURN_ADDRESS=
DELHIVERY_RETURN_CITY=
DELHIVERY_RETURN_STATE=
DELHIVERY_RETURN_PINCODE=
DELHIVERY_RETURN_PHONE=
# Receives an alert if serviceability validation or shipment creation fails.
DELHIVERY_ALERT_EMAIL=manoj.officialmail@gmail.com

# Email - Resend. Optional for local development. If blank, email sending is skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM="House of Eon <orders@yourdomain.com>"
OFFICE_EMAIL=office@houseofeon.in

# OpenAI - server side only. Powers EON Concierge (components/PerfumeAssistant.tsx),
# shown site-wide except /checkout and /admin. If blank, the concierge
# returns a friendly "not set up yet" error and points customers to
# WhatsApp instead of failing hard — same soft-fail spirit as Resend above,
# but 500 status so it's obvious in logs.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxx
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional, defaults to false (concierge always shown, opening line B).
# Set to "true" to run the no-concierge vs concierge A/B experiment
# described in lib/assistantSession.ts.
NEXT_PUBLIC_CONCIERGE_AB_TEST=false

# Analytics — GA4/Meta Pixel/Clarity IDs aren't listed here (this file
# predates them being documented) but are read the same way, via
# NEXT_PUBLIC_GA_MEASUREMENT_ID / NEXT_PUBLIC_META_PIXEL_ID /
# NEXT_PUBLIC_MICROSOFT_CLARITY_ID. All of these, plus GTM below, only
# actually load on www.houseofeon.in (see components/AnalyticsScripts.tsx)
# — never on localhost or a preview deploy, on purpose.
#
# Google Tag Manager container — currently just holds a Google Ads
# conversion tag. Leave blank to skip loading GTM entirely.
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-xxxxxxx

# Admin
ADMIN_PASSWORD=change-this-password
ADMIN_ACCESS_TOKEN=change-this-long-random-token
